# Copy to a local .env file only if needed. Do not commit real values.
JP_DUB_PORT=8787
JP_DUB_MONTHLY_LIMIT_MINUTES=30
JP_DUB_MODEL=gemini-3.5-live-translate-preview
JP_DUB_TARGET_LANGUAGE=ja
JP_DUB_ALLOW_TARGET_LANGUAGE_ECHO=false
JP_DUB_RECONNECT_SECONDS=540
# General-user setup keeps diagnostics off. Turn these on only for local audio debugging.
JP_DUB_DIAGNOSTICS=false
JP_DUB_CAPTURE_FIRST_INPUT_WAV=false
JP_DUB_CAPTURE_FIRST_OUTPUT_WAV=false
JP_DUB_CAPTURE_FIRST_INPUT_SECONDS=4
JP_DUB_CAPTURE_FIRST_OUTPUT_SECONDS=4
# Mimi Setup.command writes the fixed extension origin automatically.
# Developer override only:
# JP_DUB_ALLOWED_EXTENSION_ORIGIN=chrome-extension://oknekoaclmnljnlpmffphpiflcdeibgg
